{
  "name": "bookworm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run \"/^dev:/\"",
    "dev:server": "tsx watch --env-file-if-exists=.env src/server/main.ts",
    "dev:web": "vite",
    "build": "vite build && vite build --ssr",
    "start": "node dist/server/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "prepare": "husky"
  },
  "packageManager": "pnpm@10.23.0",
  "lint-staged": {
    "*.{ts,tsx,js,mjs,json,css,md}": "prettier --write",
    "*.{ts,tsx}": "eslint --max-warnings=0"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth/mcp": "1.7.7",
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@tanstack/react-query": "^5.104.4",
    "better-auth": "1.7.7",
    "better-sqlite3": "12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.4",
    "hono": "^4.13.13",
    "lucide-react": "^1.59.0",
    "node-html-parser": "^9.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "^8.4.0",
    "shadcn": "^4.22.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "0.31.11",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "5.0.4"
  }
}
